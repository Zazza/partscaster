# Машинные настройки воркера Partscaster.
# Скопировать в ~/partscaster/worker.env на GPU-машине и подправить под себя.
# Файл персональный: в репозиторий не попадает (юнит подхватывает через EnvironmentFile).

# Кеш весов Hugging Face (YuE2, SheetSage2, demucs качаются при первом вызове)
# HF_HOME=/opt/yue/hf-cache

# Папка данных воркера (SQLite-очередь, джобы, профили корпусов)
# PARTSCASTER_DATA_DIR=/opt/yue/partscaster-data

# Ollama (копайтер, перевод слотов, строка стиля профиля) — не обязателен
# PARTSCASTER_OLLAMA_URL=http://127.0.0.1:11434/api/chat
# PARTSCASTER_OLLAMA_MODEL=qwen2.5-chat-ru:latest

# Интерпретатор отдельного whisper-venv (faster-whisper для текстов треков)
# PARTSCASTER_WHISPER_PY=/opt/yue/whisper-venv/bin/python

# «Голос альбома» (Seed-VC, необязательно): каталог установки seedvc_install.sh,
# если не ~/partscaster/seedvc (например, на диске побольше)
# PARTSCASTER_SEEDVC_DIR=/data/yue-seedvc

# Разделение на дорожки: RoFormer + DrumSep в отдельном окружении (необязательно, см. docs/ru/deployment.md)
# PARTSCASTER_SEP_PY=/opt/yue/sep-venv/bin/python
# PARTSCASTER_SEP_MODELS=/opt/yue/sep-models
# demucs — всегда делить demucs, даже если RoFormer выбран и установлен
# PARTSCASTER_STEMS_MODEL=demucs

# Второй движок yue2.cpp (эксперимент): своя программа yue-server и каталог моделей GGUF
# PARTSCASTER_CPP_BIN=/opt/yue/yue2cpp/yue-server
# PARTSCASTER_CPP_MODELS=/opt/yue/yue2cpp-models

# Режим основного движка: torch (по умолчанию) | torch-eager (без CUDA-графов — так на Windows) | vllm
# YUE2_BACKEND=torch

# Длина/характер генерации
# YUE2_MAX_TOKENS=16000   # бюджет токенов на песню ≈ макс. длина (дефолт протокола 9000 ≈ 4.5–6 мин)
# YUE2_CFG_SCALE=1.5      # следование стилю (выше — точнее, но суше)

# Звуковой движок (POST /jobs/{id}/fx): пакеты NAM, поставленные отдельной папкой
# (pip install --target, см. docs/ru/deployment.md) — нужны только блоку amp
# PARTSCASTER_NAM_DEPS=/opt/yue/nam-deps
# 0 — выключить движок (откат на эффекты ffmpeg приложения), что бы ни было в настройках
# PARTSCASTER_FX_ENGINE=0
