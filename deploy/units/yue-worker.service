[Unit]
Description=Yue Studio Worker (API :8091, резидентная YuE2Pipeline)
After=network-online.target
Wants=network-online.target

[Service]
# код — текущая версия из архива (install.sh переключает ссылку current); данные и worker.env — в ~/yue-studio
WorkingDirectory=%h/yue-studio/current
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# данные — рядом с кодом (install.sh подставляет свой YUE_HOME); worker.env главнее, его YUE_DATA_DIR побеждает
Environment="YUE_DATA_DIR=%h/yue-studio/data"
# каталог установки: там воркер ищет собранную install.sh программу yue2.cpp (yue2cpp-src)
Environment="YUE_HOME=%h/yue-studio"
EnvironmentFile=%h/yue-studio/worker.env
ExecStart="%h/yue/.venv/bin/python" -m uvicorn yue_worker:app --host 0.0.0.0 --port 8091
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
