[Unit]
Description=Partscaster Worker (API :8091, резидентная YuE2Pipeline)
After=network-online.target
Wants=network-online.target

[Service]
# код — текущая версия из архива (install.sh переключает ссылку current); данные и worker.env — в ~/partscaster
WorkingDirectory=%h/partscaster/current
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# данные — рядом с кодом (install.sh подставляет свой PARTSCASTER_HOME); worker.env главнее, его PARTSCASTER_DATA_DIR побеждает
Environment="PARTSCASTER_DATA_DIR=%h/partscaster/data"
# каталог установки: там воркер ищет собранную install.sh программу yue2.cpp (yue2cpp-src)
Environment="PARTSCASTER_HOME=%h/partscaster"
EnvironmentFile=%h/partscaster/worker.env
ExecStart="%h/yue/.venv/bin/python" -m uvicorn yue_worker:app --host 0.0.0.0 --port 8091
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
